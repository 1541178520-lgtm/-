{
  "name": "student-growth-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/scrub-build-secrets.mjs",
    "build:desktop": "tsc -p tsconfig.electron.json && vite build --config vite.desktop.config.ts",
    "desktop:pack": "npm run build:desktop && electron-builder --win portable",
    "electron:dev": "npm run build:desktop && electron .",
    "preview": "vite preview",
    "build:production": "tsc -b && vite build --config vite.production.config.ts && node scripts/scrub-build-secrets.mjs",
    "build:pages": "tsc -b && vite build --config vite.github-pages.config.ts",
    "deploy": "npm run build:production && wrangler deploy",
    "admin:create": "node scripts/create-admin.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:worker && npm run test:ui",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:desktop": "vitest run --config vitest.desktop.config.ts",
    "test:e2e": "playwright test",
    "e2e:serve": "node scripts/reset-e2e.mjs && vite --host 127.0.0.1"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "hono": "^4.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.0.0"
  },
  "build": {
    "appId": "cn.chuangxinxueyuan.studentarchive",
    "productName": "创新学苑学生成长档案系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "dist-electron/**/*",
      "public/brand/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "latest",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  }
}
