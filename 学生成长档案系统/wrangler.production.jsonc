{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-growth-archive",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "student-growth-archive",
      "database_id": "1fec68db-4da2-4b5a-a6c3-5dd9169be7c9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://student-growth-archive.chuangxin-xueyuan.workers.dev,https://1541178520-lgtm.github.io",
    "SESSION_COOKIE_SECURE": "true",
    "SESSION_COOKIE_SAMESITE": "None"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
